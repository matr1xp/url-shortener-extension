{
  "manifest_version": 3,
  "name": "ml1.app URL Shortener",
  "version": "1.0.0",
  "description": "Shorten links with your ml1.app shortener. Click the toolbar button to shorten the current tab, or right-click any link.",
  "permissions": ["activeTab", "contextMenus", "clipboardWrite", "storage"],
  "host_permissions": ["https://s.ml1.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Shorten this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "shorten-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Shorten the current tab's URL"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ml1-shortener@marlsantos.com",
      "strict_min_version": "121.0"
    }
  }
}